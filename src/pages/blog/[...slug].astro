---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getRelatedWork, isVisible, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('writing', isVisible);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: Post; }
const { post } = Astro.props;
const [{ Content }, relatedWork] = await Promise.all([render(post), getRelatedWork(post)]);
---

<ArticleLayout post={post} relatedWork={relatedWork}>
  <Content />
</ArticleLayout>
