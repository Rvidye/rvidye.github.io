---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { demoUrl, formatDate, getPosts, isoDate, postUrl, workUrl } from '../lib/content';
import { Content as Intro } from '../content/home/intro.md';
import { Content as Now, frontmatter as now } from '../content/home/now.md';
import { Content as Explore, frontmatter as explore } from '../content/home/explore.md';
import { Content as UsefulLinks } from '../content/home/links.md';
import teapot from '../assets/about/siggraph-2026-teapot.jpg';

interface ThreadRef {
  work?: string;
  demo?: string;
  title: string;
  note?: string;
}

const refs: ThreadRef[] = explore.threads ?? [];
const resolved = await Promise.all(refs.map(async (ref) => {
  if (Boolean(ref.work) === Boolean(ref.demo)) {
    throw new Error('home/explore.md: each thread needs exactly one work or demo ID.');
  }
  const entry = ref.work ? await getEntry('work', ref.work) : await getEntry('demos', ref.demo!);
  if (!entry) throw new Error(`home/explore.md: missing ${ref.work ? 'work' : 'demos'}/${ref.work ?? ref.demo}.`);
  if (entry.data.draft) return undefined;
  return { ...ref, href: entry.collection === 'work' ? workUrl(entry) : demoUrl(entry), source: entry.data.title.split(':')[0] };
}));
const threads = resolved.filter((thread): thread is NonNullable<typeof thread> => thread !== undefined);
const posts = (await getPosts()).filter(post => !post.data.draft).slice(0, 3);
const nowUpdated = now.updated ? new Date(now.updated) : undefined;
---

<BaseLayout>
  <div class="personal-home">
    <header class="personal-intro">
      <div class="welcome">
        <h1>Hi, I’m Rushikesh.</h1>
      </div>
      <div class="intro-copy"><Intro /></div>
      <figure class="personal-photo">
        <a href="/about/#photos">
          <Image src={teapot} alt="Rushikesh smiling and holding a signed Utah teapot." widths={[240, 400, 640]} sizes="(min-width: 48rem) 200px, 112px" loading="eager" fetchpriority="high" />
        </a>
        <figcaption>Teapot Signed by Martin Newell and Jim Blinn. <a href="/about/#photos">More photos <span aria-hidden="true">↗</span></a></figcaption>
      </figure>
      <p class="personal-links"><a href="/about/">More about me</a><a href="mailto:rvidye@gmail.com">Say hello <span aria-hidden="true">↗</span></a></p>
    </header>

    <div class:list={['home-body', { 'has-posts': posts.length > 0 }]}>
      <section class="lately" aria-labelledby="lately-title">
        <header class="section-header">
          <h2 id="lately-title">Lately</h2>
          {nowUpdated && <p class="updated">Updated <time datetime={isoDate(nowUpdated)}>{formatDate(nowUpdated, 'short')}</time></p>}
        </header>
        <div class="now-copy"><Now /></div>
      </section>

      {threads.length > 0 && <section class="threads" aria-labelledby="threads-title">
        <h2 id="threads-title">Follow a thread</h2>
        <div class="section-intro"><Explore /></div>
        <ul role="list">
          {threads.map(thread => <li>
            <h3><a href={thread.href}>{thread.title}</a></h3>
            {thread.note && <p>{thread.note}</p>}
            <span class="thread-source">{thread.source}</span>
          </li>)}
        </ul>
        <p class="archive-link"><a href="/projects/">All projects & the showreel <span aria-hidden="true">↗</span></a><a href="/demos/">Demos <span aria-hidden="true">↗</span></a></p>
      </section>}

      {posts.length > 0 && <section class="recent-posts" aria-labelledby="posts-title">
        <header class="section-header"><h2 id="posts-title">From the blog</h2><a href="/blog/">All posts <span aria-hidden="true">↗</span></a></header>
        <ul role="list">{posts.map(post => <li>
          {post.data.date && <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, 'short')}</time>}
          <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
        </li>)}</ul>
      </section>}

      <section class="link-shelf" aria-label="Useful things"><UsefulLinks /></section>
    </div>
  </div>
</BaseLayout>

<style>
  /* On the page grid (see .grid in global.css): text on columns 1–8, the photo
     and the side sections on 9–12, so they line up with every other page. */
  .personal-intro { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-areas: 'welcome welcome welcome welcome welcome welcome welcome welcome photo photo photo photo' 'intro intro intro intro intro intro intro intro photo photo photo photo' 'contact contact contact contact contact contact contact contact photo photo photo photo'; column-gap: var(--grid-gap); align-content: start; padding-bottom: 2.75rem; }
  .welcome { grid-area: welcome; }
  h1 { margin: 0 0 1.25rem; font-size: clamp(2.25rem, 4vw, 3.1rem); line-height: 1.12; letter-spacing: -.04em; }
  .intro-copy { grid-area: intro; max-width: var(--measure); font-size: 1.02rem; }
  .intro-copy :global(p) { margin-bottom: 1rem; }
  .intro-copy :global(a) { text-decoration-thickness: 1px; }
  .personal-photo { grid-area: photo; align-self: start; width: min(100%, 12.5rem); margin: .25rem 0 0; }
  .personal-photo > a { display: block; }
  .personal-photo img { width: 100%; height: auto; }
  figcaption { font-size: .73rem; line-height: 1.5; margin-top: .6rem; color: var(--color-ink-muted); }
  figcaption a { display: block; width: fit-content; margin-top: .25rem; }
  .personal-links { grid-area: contact; display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; align-self: end; margin: .3rem 0 0; font-size: .85rem; }
  .home-body { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-areas: 'threads threads threads threads threads threads threads threads lately lately lately lately' 'threads threads threads threads threads threads threads threads shelf shelf shelf shelf'; column-gap: var(--grid-gap); row-gap: 2rem; align-items: start; padding-top: 2.25rem; border-top: 1px solid var(--color-rule); }
  .home-body.has-posts { grid-template-areas: 'threads threads threads threads threads threads threads threads lately lately lately lately' 'threads threads threads threads threads threads threads threads shelf shelf shelf shelf' 'posts posts posts posts posts posts posts posts shelf shelf shelf shelf'; }
  .lately { grid-area: lately; }
  .threads { grid-area: threads; }
  .recent-posts { grid-area: posts; }
  .link-shelf { grid-area: shelf; }
  h2, .link-shelf :global(h2) { margin: 0 0 .85rem; font-size: 1.65rem; }
  .section-header { margin-bottom: .8rem; }
  .section-header h2 { margin-bottom: .4rem; }
  .updated { margin: 0; color: var(--color-ink-muted); font-size: .72rem; }
  .now-copy { font-size: .9rem; }
  .now-copy :global(p:last-child) { margin-bottom: 0; }
  .section-intro { font-size: .87rem; color: var(--color-ink-muted); margin-bottom: 1.65rem; }
  .section-intro :global(p) { margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; }
  .threads li + li { margin-top: 1.7rem; }
  h3 { margin: 0 0 .45rem; font-size: 1.33rem; line-height: 1.3; }
  h3 a { text-decoration-color: var(--color-rule); }
  h3 a:hover { text-decoration-color: var(--color-rust); }
  .threads li > p { margin: 0 0 .3rem; font-size: .86rem; line-height: 1.6; }
  .thread-source { font-size: .72rem; color: var(--color-ink-muted); }
  .archive-link { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; margin: 1.8rem 0 0; font-size: .79rem; }
  .link-shelf { font-size: .83rem; line-height: 1.6; }
  .link-shelf :global(p) { margin-bottom: 1rem; }
  .link-shelf :global(ul) { list-style: none; margin: 0; padding: 0; }
  .link-shelf :global(li + li) { margin-top: .95rem; }
  .recent-posts { border-top: 1px solid var(--color-rule); padding-top: 1.75rem; }
  .recent-posts .section-header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem; }
  .recent-posts .section-header > a { font-size: .78rem; }
  .recent-posts li + li { margin-top: 1.5rem; }
  .recent-posts time { display: block; margin-bottom: .4rem; font-size: .74rem; color: var(--color-ink-muted); }
  @media (max-width: 47.99rem) {
    .personal-intro { grid-template-columns: minmax(0, 1fr) 7rem; grid-template-areas: 'welcome photo' 'intro intro' 'contact contact'; column-gap: 1.5rem; row-gap: 1.25rem; }
    .welcome { align-self: center; }
    h1 { font-size: clamp(1.9rem, 5.8vw, 2.5rem); margin-bottom: 0; }
    .personal-photo { margin: 0; }
    figcaption { font-size: .67rem; }
    .intro-copy { max-width: 100%; }
    .personal-links { margin-top: 0; }
    .home-body { grid-template-columns: 1fr; grid-template-areas: 'lately' 'threads' 'shelf'; gap: 2.5rem; }
    .home-body.has-posts { grid-template-areas: 'lately' 'threads' 'posts' 'shelf'; }
    .now-copy { max-width: 38rem; }
    .link-shelf { border-top: 1px solid var(--color-rule); padding-top: 1.75rem; }
  }
</style>
