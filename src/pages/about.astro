---
/*
 * About: bio and photos, then the CV. The bio is src/content/home/bio.md; the
 * CV lists are in src/lib/cv.ts; publications and project awards come from the
 * content collections. Photos are listed below with their captions.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { CONTACT, RESUME_PATH } from '../lib/site';
import { AWARDS, EDUCATION, EXPERIENCE, LEADERSHIP, SKILLS, type CvItem } from '../lib/cv';
import { getPublicationProjects, getPublications, getRecognition } from '../lib/content';
import { Content as Bio } from '../content/home/bio.md';
import profile from '../assets/about/profile.jpg';
import photo2025 from '../assets/about/photo-2025-09.jpg';
import hallway from '../assets/about/siggraph-2026-hallway.jpg';
import group from '../assets/about/siggraph-2026-group.jpg';
import teapot from '../assets/about/siggraph-2026-teapot.jpg';

// In pairs: on wide screens each pair shares a row at equal height.
const photos: { src: ImageMetadata; alt: string; caption: string }[] = [
  { src: photo2025, alt: 'Two people posing together in a hallway, chairs stacked behind them.', caption: 'I met Peter Shirley' },
  { src: hallway, alt: 'Two people smiling at SIGGRAPH 2026, one in a HairFarm T-shirt, the other making a peace sign.', caption: 'Photo with Cem after SIGGRAPH 2026 RTL' },
  { src: group, alt: 'Three people with SIGGRAPH badges standing together in a busy restaurant.', caption: 'Met Martin Newell and Jim Blinn at Utah Teapot Party in LA 2026' },
  { src: teapot, alt: 'A person in a plaid shirt holding up a white teapot with a signature on it.', caption: 'SIGNED Teapot by Martin Newell and Jim Blinn' },
];

const [publications, pubProjects] = await Promise.all([getPublications(), getPublicationProjects()]);
const recognition = [
  ...(await getRecognition()).map((r) => ({ label: r.label, url: r.url, year: r.year, note: undefined, source: r.source, sourceUrl: r.sourceUrl })),
  ...AWARDS.map((a) => ({ ...a, source: undefined, sourceUrl: undefined })),
].sort((a, b) => (b.year ?? 0) - (a.year ?? 0));

const sections: { id: string; title: string; items: CvItem[] }[] = [
  { id: 'education', title: 'Education', items: EDUCATION },
  { id: 'experience', title: 'Experience', items: EXPERIENCE },
];
const photoWidths = (src: ImageMetadata) => [400, 640, 960].filter((w) => w < src.width).concat(src.width);
---

<BaseLayout title="About" description="Rushikesh Vidye: graphics engineer and MS student at the University of Utah. Bio, CV, publications, and contact." image={{ src: profile, alt: 'Portrait of Rushikesh Vidye.' }}>
  <article class="about">
    <header class="about-head grid">
      <Image class="portrait col-aside" src={profile} alt="Portrait of Rushikesh Vidye." widths={[320, 480, profile.width]} sizes="(min-width: 48rem) 15rem, 10rem" loading="eager" />
      <div class="bio col-text">
        <h1>Hi, I’m Rushikesh.</h1>
        <div class="bio-text"><Bio /></div>
        <ul class="contact" role="list">
          {CONTACT.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          {RESUME_PATH && <li><a href={RESUME_PATH}>Resume (PDF)</a></li>}
        </ul>
      </div>
    </header>

    <ul class="photos" id="photos" role="list" aria-label="Photos">
      {
        photos.map((photo) => (
          <li style={`--ratio: ${(photo.src.width / photo.src.height).toFixed(4)}`}>
            <figure>
              <Image src={photo.src} alt={photo.alt} widths={photoWidths(photo.src)} sizes="(min-width: 54rem) 36rem, 60vw" />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    {
      sections.map((section) => (
        <section class="cv" aria-labelledby={section.id}>
          <h2 id={section.id}>{section.title}</h2>
          {section.items.map((item) => (
            <div class="entry grid">
              <p class="when col-aside">{item.when}</p>
              <div class="what col-text">
                <h3>{item.what}</h3>
                <p class="where">{item.where}{item.place && <span class="place"> · {item.place}</span>}</p>
                {item.detail && <p class="detail">{item.detail}</p>}
                {item.points && <ul>{item.points.map((point) => <li>{point}</li>)}</ul>}
                {item.links && (
                  <p class="links">
                    {item.links.map((link, i) => <>{i > 0 && ' · '}<a href={link.url}>{link.label}</a></>)}
                  </p>
                )}
              </div>
            </div>
          ))}
        </section>
      ))
    }

    {
      publications.length > 0 && (
        <section class="cv" aria-labelledby="publications">
          <h2 id="publications">Publications</h2>
          <div class="list publications">{publications.map((entry) => <PublicationEntry entry={entry} project={pubProjects.get(entry.id)} />)}</div>
        </section>
      )
    }

    {
      recognition.length > 0 && (
        <section class="cv" aria-labelledby="recognition">
          <h2 id="recognition">Awards and recognition</h2>
          <ul class="list recognition" role="list">
            {recognition.map((r) => (
              <li class="grid">
                <span class="year col-aside">{r.year}</span>
                <span class="col-text">
                  {r.url ? <a href={r.url}>{r.label}</a> : r.label}
                  {r.source && r.sourceUrl && <> (<a href={r.sourceUrl}>{r.source}</a>)</>}
                  {r.note && <span class="note"> {r.note}.</span>}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="cv" aria-labelledby="leadership">
      <h2 id="leadership">Teaching and leadership</h2>
      {
        LEADERSHIP.map((item) => (
          <div class="entry grid">
            <p class="when col-aside">{item.when}</p>
            <div class="what col-text">
              <h3>{item.what}</h3>
              <p class="where">{item.where}</p>
              {item.points && <ul>{item.points.map((point) => <li>{point}</li>)}</ul>}
            </div>
          </div>
        ))
      }
    </section>

    <section class="cv" aria-labelledby="skills">
      <h2 id="skills">Skills</h2>
      <dl class="list skills">
        {SKILLS.map((group) => <><dt>{group.label}</dt><dd>{group.items.join(', ')}</dd></>)}
      </dl>
    </section>
  </article>
</BaseLayout>

<style>
  /* On the page grid: text on the left line, the portrait and every date on
     the aside line, photos across the full width. */
  .about-head { align-items: start; }
  .portrait { display: block; width: min(100%, 15rem); height: auto; margin-bottom: 1.5rem; }
  h1 { margin: 0 0 1.25rem; font-size: clamp(2.2rem, 1.6rem + 2vw, 3rem); letter-spacing: -0.03em; }
  .bio-text { max-width: var(--measure); font-size: 1.08rem; }
  .bio-text :global(p) { margin: 0 0 0.9rem; }
  .contact { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: 1.25rem 0 0; padding: 0; list-style: none; font-size: 0.9rem; }

  /* Justified rows: each photo grows in proportion to its width/height, so the
     photos sharing a row end up the same height. Gaps match the page grid. */
  .photos { --row: 7rem; display: flex; flex-wrap: wrap; gap: 1rem var(--grid-gap); margin: 3rem 0 0; padding: 0; list-style: none; }
  .photos li { flex: var(--ratio) 1 calc(var(--ratio) * var(--row)); }
  .photos figure { margin: 0; }
  .photos img { display: block; width: 100%; height: auto; background: var(--color-paper-shade); }
  .photos figcaption { margin-top: 0.35rem; color: var(--color-ink-muted); font-size: var(--text-xs); }

  .cv { margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-ink); }
  h2 { margin: 0 0 1.5rem; font-size: 1.6rem; }
  .entry { align-items: start; }
  .entry + .entry { margin-top: 1.75rem; }
  .when { margin: 0; color: var(--color-ink-muted); font-size: var(--text-sm); }
  .what { max-width: min(100%, var(--measure)); }
  h3 { margin: 0; font-size: 1.05rem; line-height: 1.4; }
  .where { margin: 0.1rem 0 0; }
  .place, .detail { color: var(--color-ink-muted); }
  .detail { margin: 0; font-size: var(--text-sm); }
  .what ul { margin: 0.6rem 0 0; padding-left: 1.1rem; font-size: 0.95rem; }
  .what li + li { margin-top: 0.35rem; }
  .links { margin: 0.6rem 0 0; font-size: var(--text-sm); }

  .list { max-width: min(var(--text-span), var(--measure)); }
  .publications { display: grid; gap: 1.75rem; }
  .recognition { max-width: none; padding: 0; list-style: none; }
  .recognition li { align-items: baseline; }
  .recognition li + li { margin-top: 0.75rem; }
  .recognition .col-text { max-width: var(--measure); }
  .year { color: var(--color-ink-muted); font-size: var(--text-sm); font-style: normal; }
  .note { color: var(--color-ink-muted); }

  .skills { margin: 0; }
  .skills dt { color: var(--color-ink-muted); font-family: var(--font-sans); font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; }
  .skills dd { margin: 0.1rem 0 0; }
  .skills dd + dt { margin-top: 0.9rem; }

  @media (min-width: 48rem) {
    .about-head > *, .entry > *, .recognition li > * { grid-row: 1; }
    .portrait { margin: 0.4rem 0 0; }
    .when { padding-top: 0.2rem; }
    .photos { --row: 14rem; }
  }

  @media (max-width: 47.99rem) {
    .portrait { width: 10rem; }
    .when { margin-bottom: 0.15rem; }
  }
</style>
