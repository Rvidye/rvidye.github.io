---
/*
 * A demo's page, on the same ProjectPage shell as project pages. The lead is
 * the demo itself: ShaderToy's player behind the thumbnail (from `embedUrl`, or
 * built from a ShaderToy `url`), a demo built in this repo, or else its thumbnail.
 */
import { existsSync } from 'node:fs';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import ProjectPage from '../../layouts/ProjectPage.astro';
import ShaderToy from '../../components/ShaderToy.astro';
import { getDemoWork, getDemos, isLocalDemo, workUrl, type Demo, type LinkItem } from '../../lib/content';

export async function getStaticPaths() {
  return (await getDemos()).filter((demo) => demo.id !== 'shader-study').map((demo) => ({
    params: { slug: demo.id }, props: { demo },
  }));
}

interface Props { demo: Demo; }

const { demo } = Astro.props;
const { data } = demo;
const { Content } = await render(demo);
const local = isLocalDemo(demo);
const shaderToy = !local && new URL(data.url).hostname.replace(/^www\./, '') === 'shadertoy.com';
const built = local && existsSync(`public/lab/${demo.id}/index.html`);

if (local && !built && import.meta.env.PROD) {
  throw new Error(`Demo "${demo.id}" has not been built. Check the build:demos step.`);
}

const work = await getDemoWork(demo);
const host = data.host ?? (local ? undefined : new URL(data.url).hostname);
const links: LinkItem[] = [{ label: local ? 'Open full screen' : `Open on ${host}`, url: data.url }];
if (data.source) links.push({ label: 'Source code', url: data.source });
if (work) links.push({ label: work.data.title, url: workUrl(work), prefix: 'Part of' });
const facts = [local ? 'Runs in your browser' : `Runs on ${host}`, ...data.requires.map((r) => `Requires ${r}`)];
---

<ProjectPage
  title={data.title}
  description={data.description}
  kind="Demo"
  facts={facts}
  links={links}
  recognition={data.recognition}
  details={[
    { label: 'Made with', items: data.technologies.map((t) => ({ label: t })) },
  ]}
  back={{ label: 'Demos', href: '/demos/' }}
  section="/demos/"
  image={data.thumbnail}
  draft={data.draft}
>
  <Fragment slot="lead">
    {
      shaderToy ? (
        <ShaderToy src={data.embedUrl ?? data.url} title={`${data.title}: interactive ShaderToy demo`} poster={data.thumbnail} />
      ) : local ? (
        built ? (
          <iframe class="demo-frame" src={`${data.url}?embed`} title={`${data.title}: interactive demo`} loading="lazy" allow="fullscreen" />
        ) : (
          <p class="draft-banner">The interactive demo will be available after its next build.</p>
        )
      ) : (
        data.thumbnail && (
          <Image src={data.thumbnail.src} alt={data.thumbnail.alt} widths={[640, 960, 1280].filter((w) => w < data.thumbnail!.src.width).concat(data.thumbnail.src.width)} sizes="(min-width: 58rem) 56rem, calc(100vw - 2rem)" loading="eager" />
        )
      )
    }
  </Fragment>

  <Content />
</ProjectPage>

<style>
  .demo-frame { display: block; width: 100%; aspect-ratio: 16 / 10; border: 0; background: var(--color-paper-shade); }
</style>
