---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** For pages that should not be indexed or canonicalised, such as 404. */
  noindex?: boolean;
  /** Nav section to highlight when the URL doesn't match one, e.g. '/research/'. */
  section?: string;
  /** Social preview image. Only real imagery: leave it out rather than use a placeholder. */
  image?: { src: ImageMetadata; alt: string };
  /** Open Graph type. Articles also pass their publication date. */
  type?: 'website' | 'article';
  published?: Date;
  /** Let the page lay out its own full-width bands instead of the centred column. */
  bleed?: boolean;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  section,
  image,
  type = 'website',
  published,
  bleed = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;

// A 1200px JPEG is the most widely accepted size and format for link previews.
const socialImage = image ? await getImage({ src: image.src, width: 1200, format: 'jpg' }) : undefined;
const socialImageUrl = socialImage && Astro.site ? new URL(socialImage.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {noindex && <meta name="robots" content="noindex" />}

    {/* Link previews (Open Graph, also read by most chat apps and social sites). */}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {
      socialImageUrl && image && (
        <>
          <meta property="og:image" content={socialImageUrl} />
          <meta property="og:image:alt" content={image.alt} />
          <meta property="og:image:width" content={String(socialImage?.attributes.width)} />
          <meta property="og:image:height" content={String(socialImage?.attributes.height)} />
        </>
      )
    }
    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />

    {/* Preload only the body text face; the rest load when first used. */}
    <Font cssVariable="--font-serif" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-mono" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f0e4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161917" media="(prefers-color-scheme: dark)" />
    {/* Apply a theme the reader chose with the header switch before the page
        draws, so it doesn't flash. Without one, the system setting applies. */}
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title}: blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header section={section} />
    <main id="main" class:list={[bleed ? 'bleed' : 'wrap']}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main.wrap {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) var(--space-8);
  }
</style>
