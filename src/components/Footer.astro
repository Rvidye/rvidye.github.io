---
import { CONTACT, SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner meta">
    <p>© {year} {SITE.title}</p>
    <ul role="list" aria-label="Contact and subscribe">
      {CONTACT.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
</footer>

<style>
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 2rem 2.5rem;
    font-size: 0.8rem;
    border-top: 1px solid var(--color-rule);
  }

  p { margin: 0; }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a { text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
