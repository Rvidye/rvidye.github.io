---
/*
 * Two renders of the same view, one over the other, with a divider to drag
 * across: before on the left, after on the right. The images must have the
 * same aspect ratio.
 *
 *   <CompareSlider
 *     before={{ src: oldRender, alt: '…', label: 'First attempt · 7 hours' }}
 *     after={{ src: newRender, alt: '…', label: 'FoxRT · 35 minutes' }}
 *   >
 *     Optional caption.
 *   </CompareSlider>
 *
 * In MDX, keep the `>` on its own line: a line starting with `>` and text is
 * a Markdown quotation and breaks the page.
 *
 * The divider is a real range input: drag it, or focus it and use the arrow
 * keys. Without JavaScript it rests in the middle, showing half of each.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Side {
  src: ImageMetadata;
  alt: string;
  label: string;
}

interface Props {
  before: Side;
  after: Side;
}

const { before, after } = Astro.props;
const widths = (src: ImageMetadata) => [640, 960, 1280, 1920].filter((w) => w < src.width).concat(src.width);
const sizes = '(min-width: 58rem) 56rem, calc(100vw - 2rem)';
---

<figure class="compare" data-compare style="--position: 50%">
  <div class="stage">
    <Image class="after" src={after.src} alt={after.alt} widths={widths(after.src)} sizes={sizes} />
    <Image class="before" src={before.src} alt={before.alt} widths={widths(before.src)} sizes={sizes} />
    <span class="label label-before" aria-hidden="true">{before.label}</span>
    <span class="label label-after" aria-hidden="true">{after.label}</span>
    <span class="divider" aria-hidden="true"><span class="knob">⟷</span></span>
    <input
      type="range"
      min="0"
      max="100"
      step="0.5"
      value="50"
      aria-label={`Compare: left is ${before.label}, right is ${after.label}`}
    />
  </div>
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-compare]')) {
    const input = root.querySelector('input')!;
    const update = () => root.style.setProperty('--position', `${input.value}%`);
    input.addEventListener('input', update);
    update();
  }
</script>

<style>
  .compare {
    margin-block: var(--space-6);
  }

  .stage {
    position: relative;
    overflow: hidden;
    background: var(--color-paper-shade);
    user-select: none;
  }

  .stage :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The "before" render covers the left part, up to the divider. */
  .stage :global(img.before) {
    position: absolute;
    inset: 0;
    height: 100%;
    clip-path: inset(0 calc(100% - var(--position)) 0 0);
  }

  .label {
    position: absolute;
    top: var(--space-3);
    padding: 0.2em 0.6em;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: var(--text-xs);
    line-height: 1.4;
    pointer-events: none;
  }

  .label-before {
    left: var(--space-3);
  }

  .label-after {
    right: var(--space-3);
  }

  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--position);
    width: 2px;
    margin-left: -1px;
    background: var(--color-paper);
    pointer-events: none;
  }

  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-ink);
    font-size: 1.1rem;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
  }

  /* The range input covers the whole image, invisible, so dragging anywhere moves the divider. */
  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .stage:has(input:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .stage:has(input:focus-visible) .knob {
    outline: 2px solid var(--color-focus);
  }

  figcaption {
    margin-top: var(--space-2);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
</style>
