---
import { formatDate, isoDate, postUrl, type Post } from '../lib/content';

interface Props {
  items: Post[];
  headingLevel?: 2 | 3;
}

const { items, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const labels = { blog: 'Blog', technical: 'Technical', personal: 'Personal' };
---

<ul class="post-list" role="list">
  {items.map((post) => (
    <li class="post-entry">
      <p class="post-meta meta">
        {post.data.draft && <span class="draft-marker">Draft · </span>}
        {labels[post.data.kind ?? 'blog']}
        {post.data.date && <>{' · '}<time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, 'short')}</time></>}
      </p>
      <Heading><a href={postUrl(post)}>{post.data.title}</a></Heading>
      <p class="description">{post.data.description}</p>
    </li>
  ))}
</ul>

<style>
  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-entry { padding-block: 1.6rem; border-bottom: 1px solid var(--color-rule); }
  .post-entry:first-child { padding-top: 0; }
  .post-entry:last-child { border-bottom: 0; }
  .post-meta { margin: 0 0 0.5rem; font-size: 0.75rem; }
  h2, h3 { margin: 0 0 0.6rem; font-size: 1.5rem; letter-spacing: -0.02em; }
  h2 a, h3 a { text-decoration: none; }
  h2 a:hover, h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .description { max-width: 62ch; margin: 0; font-size: 0.95rem; line-height: 1.65; }
</style>
