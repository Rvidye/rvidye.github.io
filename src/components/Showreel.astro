---
/*
 * The homepage showreel: one render at a time, advancing every few seconds,
 * like a slide deck. Frames are pictures with captions, not links to pages.
 *
 * Without JavaScript the frames sit in a row that scrolls sideways. With it,
 * they stack and cross-fade, with previous, pause and next buttons and a
 * progress line. It pauses while hovered or focused, while scrolled out of
 * view, and while the tab is hidden; with reduced motion it starts paused and
 * changes frames without fading.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Frame {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  frames: Frame[];
  /** Seconds each frame stays up. */
  seconds?: number;
}

const { frames, seconds = 5 } = Astro.props;
const widths = (src: ImageMetadata) => [640, 960, 1280, 1920].filter((w) => w < src.width).concat(src.width);
// Frames close to 16:9 fill the stage; squares and portraits are shown whole.
const fit = (src: ImageMetadata) => (Math.abs(src.width / src.height / (16 / 9) - 1) < 0.15 ? 'cover' : 'contain');
---

<div class="reel" style={`--seconds: ${seconds}s`} aria-roledescription="carousel" aria-label="Showreel">
  <div class="stage">
    <ul class="slides" role="list">
      {
        frames.map((frame, i) => (
          <li class:list={['slide', { current: i === 0 }]} aria-roledescription="slide" aria-label={`${i + 1} of ${frames.length}`}>
            <figure>
              <Image
                src={frame.src}
                alt={frame.alt}
                widths={widths(frame.src)}
                sizes="(min-width: 70rem) 68rem, calc(100vw - 2rem)"
                loading={i < 2 ? 'eager' : 'lazy'}
                style={`object-fit: ${fit(frame.src)}`}
              />
              <figcaption>{frame.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
    <div class="progress" aria-hidden="true"><span></span></div>
  </div>
  <div class="controls" hidden>
    <p class="count" aria-live="off" aria-atomic="true"><span class="index">1</span> / {frames.length}<span class="visually-hidden">: <span class="now">{frames[0]?.caption}</span></span></p>
    <button type="button" class="prev" aria-label="Previous render"><span aria-hidden="true">←</span></button>
    <button type="button" class="toggle" aria-label="Pause the showreel"><span aria-hidden="true">Pause</span></button>
    <button type="button" class="next" aria-label="Next render"><span aria-hidden="true">→</span></button>
  </div>
</div>

<script>
  for (const reel of document.querySelectorAll<HTMLElement>('.reel')) {
    const slides = [...reel.querySelectorAll<HTMLElement>('.slide')];
    const list = reel.querySelector<HTMLElement>('.slides')!;
    const controls = reel.querySelector<HTMLElement>('.controls')!;
    const toggle = reel.querySelector<HTMLButtonElement>('.toggle')!;
    const count = reel.querySelector<HTMLElement>('.count')!;
    const index = reel.querySelector<HTMLElement>('.index')!;
    const now = reel.querySelector<HTMLElement>('.now')!;
    const bar = reel.querySelector<HTMLElement>('.progress span')!;
    if (slides.length < 2) continue;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    // Why the reel is paused: the reader's choice, hovering, focus, off screen, hidden tab.
    let chosen = reduce.matches;
    let hovered = false;
    let focused = false;
    let visible = true;

    reel.classList.add('enhanced');
    controls.hidden = false;

    // Frames the reader asks for are announced; the automatic ones every few seconds are not.
    const show = (next: number, asked = false) => {
      count.setAttribute('aria-live', asked ? 'polite' : 'off');
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const offset = (i - current + slides.length) % slides.length;
        slide.classList.toggle('current', offset === 0);
        // The neighbours are laid out (and their images load) before they are needed.
        slide.classList.toggle('near', offset === 1 || offset === slides.length - 1);
        slide.toggleAttribute('inert', offset !== 0);
      });
      index.textContent = String(current + 1);
      now.textContent = slides[current].querySelector('figcaption')?.textContent ?? '';
      // Restart the progress line, which also times the next change.
      bar.style.animation = 'none';
      void bar.offsetWidth;
      bar.style.animation = '';
    };

    const update = () => {
      const paused = chosen || hovered || focused || !visible || document.hidden;
      reel.classList.toggle('paused', paused);
      toggle.setAttribute('aria-label', chosen ? 'Play the showreel' : 'Pause the showreel');
      toggle.firstElementChild!.textContent = chosen ? 'Play' : 'Pause';
    };

    bar.addEventListener('animationend', () => show(current + 1));
    reel.querySelector('.prev')!.addEventListener('click', () => show(current - 1, true));
    reel.querySelector('.next')!.addEventListener('click', () => show(current + 1, true));
    toggle.addEventListener('click', () => {
      chosen = !chosen;
      update();
    });

    reel.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') { hovered = true; update(); }
    });
    reel.addEventListener('pointerleave', () => { hovered = false; update(); });
    // Pause while the reader is in the reel with the keyboard, but not after a
    // button press with the mouse (buttons keep focus after a click).
    reel.addEventListener('focusin', (event) => {
      focused = (event.target as HTMLElement).matches(':focus-visible');
      update();
    });
    reel.addEventListener('focusout', (event) => {
      if (!reel.contains(event.relatedTarget as Node)) { focused = false; update(); }
    });
    reel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1, true);
      else if (event.key === 'ArrowRight') show(current + 1, true);
    });

    // Swipe on touch screens.
    let startX: number | null = null;
    list.addEventListener('pointerdown', (event) => { startX = event.clientX; });
    list.addEventListener('pointerup', (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1), true);
    });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      update();
    }, { threshold: 0.25 }).observe(reel);
    document.addEventListener('visibilitychange', update);

    show(0);
    update();
  }
</script>

<style>
  .stage {
    position: relative;
    background: var(--color-night);
  }

  /* Without JavaScript: a row of frames that scrolls sideways. */
  .slides {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    list-style: none;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  figure {
    position: relative;
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    background: var(--color-night);
  }

  figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.2em 0.6em;
    background: var(--color-chip);
    color: var(--color-chip-ink);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  /* With JavaScript: frames stack in one place and cross-fade. */
  .enhanced .slides {
    display: grid;
    overflow: hidden;
    touch-action: pan-y;
  }

  .enhanced .slide {
    display: none;
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .enhanced .slide.near,
  .enhanced .slide.current {
    display: block;
  }

  .enhanced .slide.current {
    opacity: 1;
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgb(0 0 0 / 0.25);
  }

  .reel:not(.enhanced) .progress {
    display: none;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--color-night-accent);
    transform-origin: left;
    animation: progress var(--seconds) linear forwards;
  }

  .paused .progress span {
    animation-play-state: paused;
  }

  @keyframes progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }

  .controls[hidden] {
    display: none;
  }

  .count {
    margin: 0 auto 0 0;
    color: var(--color-ink-muted);
    font-variant-numeric: tabular-nums;
  }

  button {
    min-width: 2.75rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--color-rule);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    cursor: pointer;
  }

  button:hover {
    border-color: var(--color-ink);
    color: var(--color-rust);
  }

  @media (prefers-reduced-motion: reduce) {
    .enhanced .slide {
      transition: none;
    }
  }
</style>
