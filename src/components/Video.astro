---
// Local media, with native controls and no autoplay. See CONTENT_GUIDE.md.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  /** Path under public/, e.g. "/media/hairpt/clip.mp4". */
  src: string;
  poster?: ImageMetadata | string;
  width?: number;
  height?: number;
  title?: string;
  /** Older MDX can continue to use label instead of title. */
  label?: string;
  type?: string;
  /** A WebVTT file, e.g. /media/my-project/captions.vtt. */
  captions?: { src: string; srclang: string; label: string };
  /** For short clips: repeat once started. It still never starts by itself. */
  loop?: boolean;
}

const { src, poster, width = 1920, height = 1080, title, label, type = 'video/mp4', captions, loop = false } = Astro.props;
const accessibleTitle = title ?? label;
if (!accessibleTitle) throw new Error('Video needs a descriptive title.');
// Square and portrait clips leave room beside them, so on wide screens their
// caption moves into the aside column, level with the bottom of the clip.
const tall = height / width > 0.8;
const posterSrc = typeof poster === 'string' || !poster
  ? poster
  : (await getImage({ src: poster, width: Math.min(poster.width, 1280), format: 'webp' })).src;
---

<figure class:list={['video', { tall }]}>
  <video controls preload="none" playsinline loop={loop} width={width} height={height} poster={posterSrc} aria-label={accessibleTitle}>
    <source src={src} type={type} />
    {captions && <track kind="captions" src={captions.src} srclang={captions.srclang} label={captions.label} default />}
    <a href={src}>Download the video</a>.
  </video>
  {Astro.slots.has('default') && <figcaption><slot /></figcaption>}
</figure>

<style>
  /* Full width from the left line, except that tall clips (square or portrait)
     stop at 75% of the screen height, keeping their shape. */
  video {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 75svh;
    background: var(--color-paper-shade);
  }

  @supports not (height: 1svh) {
    video { max-height: 75vh; }
  }

  @media (min-width: 48rem) {
    .tall {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: end;
    }

    .tall video { grid-column: 1 / 9; }
    .tall figcaption { grid-column: 9 / -1; max-width: none; margin: 0; }
  }

  figcaption {
    margin-top: var(--space-2);
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
  }
</style>
