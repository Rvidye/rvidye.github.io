---
/*
 * The Projects list, on the page grid: title and summary on the text column,
 * the project's hero frame on the aside column (above the text on phones).
 * Projects with recognition get a ribbon on the picture (its `badge`, or the
 * label) and the full list under the summary. A project without a heroImage
 * runs as text across the row.
 */
import { Image } from 'astro:assets';
import RecognitionList from './RecognitionList.astro';
import { KIND_LABEL, STATUS_LABEL, workUrl, type Work } from '../lib/content';

interface Props {
  items: Work[];
  headingLevel?: 2 | 3;
  eagerFirstImage?: boolean;
}

const { items, headingLevel = 3, eagerFirstImage = false } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const firstImageIndex = items.findIndex((item) => item.data.heroImage);
---

<ul class="work-list" role="list">
  {items.map((item, index) => {
    const { data } = item;
    const start = data.startDate?.getUTCFullYear();
    const end = data.endDate?.getUTCFullYear();
    const years = start && end && start !== end ? `${start}–${end}` : start ?? end;
    const ribbon = data.recognition[0] && (data.recognition[0].badge ?? data.recognition[0].label);
    return (
      <li class:list={['work-entry', 'grid', { 'has-image': data.heroImage }]}>
        {data.heroImage && (
          <a class="entry-image col-aside" href={workUrl(item)} tabindex="-1" aria-hidden="true">
            <Image
              src={data.heroImage.src}
              alt=""
              widths={[400, 640, 960].filter((w) => w < data.heroImage!.src.width).concat(Math.min(data.heroImage.src.width, 1280))}
              sizes="(min-width: 70rem) 22rem, (min-width: 48rem) 32vw, calc(100vw - 2rem)"
              loading={eagerFirstImage && index === firstImageIndex ? 'eager' : 'lazy'}
            />
            {ribbon && (
              <span class="ribbon">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z" /></svg>
                {ribbon}
              </span>
            )}
          </a>
        )}
        <div class="entry-copy col-text">
          <p class="entry-meta meta">
            {data.draft && <span class="draft-marker">Draft · </span>}
            {KIND_LABEL[data.kind]} · {STATUS_LABEL[data.status]}{years && ` · ${years}`}
          </p>
          <Heading><a href={workUrl(item)}>{data.title}</a></Heading>
          <p class="description">{data.description}</p>
          {data.recognition.length > 0 && <div class="entry-recognition"><RecognitionList items={data.recognition} /></div>}
        </div>
      </li>
    );
  })}
</ul>

<style>
  .work-list { list-style: none; padding: 0; margin: 0; }
  .work-entry { padding-block: 2.25rem; border-bottom: 1px solid var(--color-rule); }
  .work-entry:first-child { padding-top: 0; }
  .work-entry:last-child { border-bottom: 0; }
  .entry-meta { margin: 0 0 0.45rem; font-size: 0.75rem; }
  h2, h3 { margin: 0 0 0.7rem; font-size: 1.65rem; letter-spacing: -0.025em; }
  h2 a, h3 a { text-decoration: none; }
  h2 a:hover, h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .description { max-width: 60ch; margin: 0; font-size: 0.95rem; line-height: 1.65; }
  .entry-recognition { margin-top: 0.9rem; }

  .entry-image { position: relative; display: block; margin-bottom: 1.25rem; background: var(--color-paper-shade); }
  .entry-image img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .entry-image:hover img { filter: brightness(1.06); }

  /* A ribbon across the top-left corner of the picture. */
  .ribbon {
    position: absolute;
    top: 0.6rem;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem 0.25rem 0.5rem;
    background: var(--color-ribbon);
    color: var(--color-ribbon-ink);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.3);
  }
  .ribbon svg { width: 0.85rem; height: 0.85rem; fill: currentColor; }

  @media (min-width: 48rem) {
    .work-entry { align-items: start; }
    .entry-copy, .entry-image { grid-row: 1; }
    .entry-image { margin-bottom: 0; }
  }
</style>
